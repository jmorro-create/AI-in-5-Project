{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/negotiator",
        "destination": "/negotiator.html"
      },
      {
        "source": "/otd-calculator",
        "destination": "/otd-calculator.html"
      },
      {
        "source": "**",
        "destination": "/negotiator.html"
      }
    ]
  }
}
